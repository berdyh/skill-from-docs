        "properties": {
          "id": {"type": "integer"},
          "name": {"type": "string"},
          "city": {"type": "string"},
          "country": {"type": "string"}
        }
      },
      "Datacenter": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "integer"},
          "name": {"type": "string"},

          "memory": {"type": "number"}
        }
      },
      "Meta": {
        "type": "object",
        "properties": {
          "pagination": {
            "type": "object",
            "properties": {
              "page": {"type": "integer"},
              "per_page": {"type": "integer"},
              "next_page": {"type": "integer", "nullable": true}
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {"type": "string"},
              "message": {"type": "string"},
              "details": {"type": "object"}
            }
          }
        }
      }
    }
